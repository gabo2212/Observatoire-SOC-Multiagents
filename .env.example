# OpenAI-compatible endpoint (llama-server)
OPENAI_API_BASE=http://127.0.0.1:8080/v1
OPENAI_API_KEY=sk-local
LLM_MODEL=Qwen3.6-35B-A3B-Heretic-Cerebellum-v1-Q3_K_M

# Path to GGUF (used by scripts/start_llm.sh)
GGUF_PATH=models/Qwen3.6-35B-A3B-Heretic-Cerebellum-v1-Q3_K_M.gguf

# llama-server tuning for RTX 4080 12GB
N_GPU_LAYERS=30
CTX_SIZE=8192
PORT=8080

# Local cost estimate (USD per 1M tokens) for observatory KPIs
COST_PER_1M_INPUT=0.0
COST_PER_1M_OUTPUT=0.0